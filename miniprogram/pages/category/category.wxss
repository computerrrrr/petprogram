/* 分类页面样式 */
.category-container {
  padding: 30rpx;
  background-color: #FFF8F0; /* 继承全局暖橙淡背景 */
  min-height: 100vh;
  box-sizing: border-box;
}

/* 双列网格布局 */
.category-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30rpx;
}

/* 分类卡片 */
.category-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 50rpx 0;
  box-shadow: 0 4rpx 12rpx rgba(255, 140, 71, 0.15); /* 暖橙色系淡阴影 */
  transition: transform 0.2s ease;
}

/* 新增：选中态高亮样式 */
.card-active {
  background-color: #FFF1E6; /* 暖橙淡色背景 */
  border: 2rpx solid #FF8C47; /* 暖橙色边框 */
  box-shadow: 0 6rpx 16rpx rgba(255, 140, 71, 0.25); /* 加深阴影 */
}

/* 卡片 Emoji 图标 */
.card-emoji {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

/* 卡片标题 */
.card-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
}

/* 新增：卡片内跳转按钮 */
.card-btn {
  font-size: 24rpx;
  color: #FF8C47;
  background-color: #FFFFFF;
  padding: 6rpx 24rpx;
  border-radius: 30rpx;
  border: 1rpx solid #FF8C47;
}

/* 选中态时按钮颜色反转 */
.card-active .card-btn {
  background-color: #FF8C47;
  color: #FFFFFF;
}