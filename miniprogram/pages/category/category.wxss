/* 分类页面样式 */
.category-container {
  padding: 30rpx;
  background-color: #FFF8F0; /* 继承全局暖橙淡背景 */
  min-height: 100vh;
  box-sizing: border-box;
}

/* 双列网格布局 */
.category-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30rpx;
}

/* 分类卡片 */
.category-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 50rpx 0;
  box-shadow: 0 4rpx 12rpx rgba(255, 140, 71, 0.15); /* 暖橙色系淡阴影 */
  transition: transform 0.2s ease;
}

/* 卡片 Emoji 图标 */
.card-emoji {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

/* 卡片标题 */
.card-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
}