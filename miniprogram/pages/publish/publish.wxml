<!-- 发布页面 - 静态UI骨架 -->
<view class="publish-container">

  <!-- 1. 宠物分类选择区域 -->
  <view class="section-card">
    <view class="section-title">选择宠物分类</view>
    <view class="category-tags">
      <view 
        class="tag-item {{item.key === selectedCategory ? 'tag-active' : ''}}" 
        wx:for="{{categories}}" 
        wx:key="key"
        bindtap="onSelectCategory"
        data-key="{{item.key}}">
        {{item.emoji}} {{item.name}}
      </view>
    </view>
  </view>

  <!-- 2. 图片上传预览区域 -->
  <view class="section-card">
    <view class="section-title">添加图片</view>
    <view class="upload-area">
      <!-- 已选图片预览列表 -->
      <view class="image-item" wx:for="{{imageList}}" wx:key="*this">
        <image class="preview-image" src="{{item}}" mode="aspectFill" />
        <view class="delete-btn" catchtap="onDeleteImage" data-index="{{index}}">×</view>
      </view>
      
      <!-- 动态占位框：不足9张时显示 -->
      <view class="upload-placeholder" bindtap="onChooseImage" wx:if="{{imageList.length < 9}}">
        <text class="upload-icon">+</text>
        <text class="upload-text">上传图片</text>
      </view>
    </view>
  </view>

  <!-- 3. 文字输入框（新增双向数据绑定） -->
  <view class="section-card">
    <view class="section-title">分享萌宠日常</view>
    <textarea 
      class="content-input" 
      placeholder="记录和宝贝的温馨时刻..." 
      placeholder-style="color: #CCCCCC;" 
      maxlength="500" 
      value="{{content}}"
      bindinput="onContentInput" 
    />
  </view>

  <!-- 4. 提交按钮（新增点击事件骨架） -->
  <button class="submit-btn" bindtap="onSubmit">发布动态</button>

</view>
