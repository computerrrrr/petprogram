<!-- 发布页面 - 静态UI骨架 -->
<view class="publish-container">

  <!-- 1. 宠物分类选择区域 -->
  <view class="section-card">
    <view class="section-title">选择宠物分类</view>
    <view class="category-tags">
      <view class="tag-item tag-active">🐱 猫猫</view>
      <view class="tag-item">🐶 狗狗</view>
      <view class="tag-item">🐦 鸟类</view>
      <view class="tag-item">🦎 异宠</view>
    </view>
  </view>

  <!-- 2. 图片上传占位区域 -->
  <view class="section-card">
    <view class="section-title">添加图片</view>
    <view class="upload-area">
      <view class="upload-placeholder">
        <text class="upload-icon">+</text>
        <text class="upload-text">上传图片</text>
      </view>
    </view>
  </view>

  <!-- 3. 文字输入框 -->
  <view class="section-card">
    <view class="section-title">分享萌宠日常</view>
    <textarea class="content-input" placeholder="记录和宝贝的温馨时刻..." placeholder-style="color: #CCCCCC;" maxlength="500" />
  </view>

  <!-- 4. 提交按钮 -->
  <button class="submit-btn">发布动态</button>

</view>
