/* 发布页面样式 */
.publish-container {
  padding: 30rpx;
  background-color: #FFF8F0;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom)); /* 适配底部安全区 */
}

/* 通用卡片样式 */
.section-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 140, 71, 0.1);
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 24rpx;
}

/* 1. 分类标签样式 */
.category-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.tag-item {
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  background-color: #F5F5F5;
  color: #666666;
}

.tag-active {
  background-color: #FFF1E6; /* 暖橙淡色背景 */
  color: #FF8C47; /* 暖橙色字 */
  border: 1rpx solid #FF8C47;
}

/* 2. 图片上传占位样式 */
.upload-area {
  display: flex;
}

.upload-placeholder {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #CCCCCC;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #FAFAFA;
}

.upload-icon {
  font-size: 60rpx;
  color: #CCCCCC;
  line-height: 1;
  margin-bottom: 10rpx;
}

.upload-text {
  font-size: 22rpx;
  color: #CCCCCC;
}

/* 3. 文本输入框样式 */
.content-input {
  width: 100%;
  height: 200rpx;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.5;
  box-sizing: border-box;
}

/* 4. 提交按钮样式 */
.submit-btn {
  width: 100% !important;
  /* height: 88rpx; */
  /* line-height: 88rpx; */
  background-color: #FF8C47;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
  text-align: center;
  margin-top: 40rpx;
  box-shadow: 0 8rpx 16rpx rgba(255, 140, 71, 0.3);
  border: none; /* 清除默认边框 */
}

/* 去除按钮默认点击态 */
.submit-btn::after {
  border: none;
}
