.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
  padding: 30rpx;
  box-sizing: border-box;
}

/* 新增：顶部搜索框样式 */
.search-bar {
  width: 100%;
  margin-bottom: 30rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 44rpx;
  padding: 16rpx 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 140, 71, 0.15);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.placeholder-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  border: 2rpx dashed #FF8C47;
  border-radius: 16rpx;
  background-color: #FFFFFF;
  margin-bottom: 40rpx;
}

.placeholder-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF8C47;
  margin-bottom: 20rpx;
}

.sub-text {
  font-size: 24rpx;
  color: #999999;
}

/* 新增：入口卡片样式 */
.entry-card {
  width: 100%;
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 140, 71, 0.15);
  box-sizing: border-box;
  margin-bottom: 30rpx; /* 确保多个卡片之间有间距 */
}

.entry-emoji {
  font-size: 56rpx;
  margin-right: 24rpx;
}

.entry-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.entry-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.entry-desc {
  font-size: 24rpx;
  color: #999999;
}

.entry-arrow {
  font-size: 32rpx;
  color: #FF8C47;
  font-weight: bold;
  margin-left: 20rpx;
}

/* 新增：宠物动态列表样式 */
.feed-list {
  padding: 0 30rpx 30rpx;
}

.feed-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 140, 71, 0.1);
}

/* 卡片顶部 */
.feed-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.feed-tag {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background-color: #FFF1E6;
  color: #FF8C47;
  margin-right: 16rpx;
  font-weight: 500;
}

.feed-nickname {
  font-size: 26rpx;
  color: #666666;
  font-weight: 500;
}

/* 宠物配图占位 */
.feed-image-box {
  width: 100%;
  height: 360rpx;
  background-color: #F8F8F8;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.feed-image-placeholder {
  font-size: 28rpx;
  color: #CCCCCC;
}

/* 文字简介 */
.feed-desc-box {
  margin-top: 10rpx;
}

.feed-desc {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

