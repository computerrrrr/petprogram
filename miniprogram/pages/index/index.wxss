.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
  padding: 30rpx;
  box-sizing: border-box;
}

.placeholder-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  border: 2rpx dashed #FF8C47;
  border-radius: 16rpx;
  background-color: #FFFFFF;
  margin-bottom: 40rpx;
}

.placeholder-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF8C47;
  margin-bottom: 20rpx;
}

.sub-text {
  font-size: 24rpx;
  color: #999999;
}

/* 新增：入口卡片样式 */
.entry-card {
  width: 100%;
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 140, 71, 0.15);
  box-sizing: border-box;
  margin-bottom: 30rpx; /* 确保多个卡片之间有间距 */
}

.entry-emoji {
  font-size: 56rpx;
  margin-right: 24rpx;
}

.entry-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.entry-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.entry-desc {
  font-size: 24rpx;
  color: #999999;
}

.entry-arrow {
  font-size: 32rpx;
  color: #FF8C47;
  font-weight: bold;
  margin-left: 20rpx;
}



