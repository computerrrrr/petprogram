<!-- 首页 - 骨架占位 -->
<view class="container">
  <!-- 新增：顶部搜索框 UI 骨架 -->
  <view class="search-bar">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input 
        class="search-input" 
        placeholder="搜索宠物品种、动态..." 
        placeholder-style="color: #CCCCCC;" 
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        confirm-type="search"
      />

      <!-- 新增：清空按钮，有输入内容时才显示 -->
      <view class="clear-btn" wx:if="{{searchKeyword.length > 0}}" catchtap="onClearSearch">
        <text class="clear-icon">×</text>
      </view>
    </view>
  </view>

  <view class="placeholder-box">
    <text class="placeholder-text">🏠 首页内容区域</text>
    <text class="motto">{{motto}}</text>
    <text class="sub-text">清新暖橙色萌宠简约风</text>
  </view>

  <!-- 新增：跳转分类页面入口卡片 -->
  <view class="entry-card" bindtap="goToCategory">
    <text class="entry-emoji">🐾</text>
    <view class="entry-info">
      <text class="entry-title">探索宠物分类</text>
      <text class="entry-desc">猫猫、狗狗、鸟类与异宠</text>
    </view>
    <text class="entry-arrow">></text>
  </view>

  <!-- 新增：跳转发布页面入口卡片 -->
  <view class="entry-card" bindtap="goToPublish">
    <text class="entry-emoji">✏️</text>
    <view class="entry-info">
      <text class="entry-title">发布萌宠动态</text>
      <text class="entry-desc">记录和宝贝的温馨时刻</text>
    </view>
    <text class="entry-arrow">></text>
  </view>

  <!-- 宠物动态卡片列表骨架 -->
  <view class="feed-list">
    <!-- 有匹配结果时渲染列表 -->
    <view class="feed-card" wx:for="{{filteredFeedList}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="feed-header">
        <view class="feed-tag">{{item.category}}</view>
        <text class="feed-nickname">{{item.nickname}}</text>
      </view>
      <view class="feed-image-box" catchtap="onPreviewImage" data-urls="{{item.imageUrls}}">
        <text class="feed-image-placeholder">🖼️ 点击预览图片</text>
      </view>
      <view class="feed-desc-box">
        <text class="feed-desc">{{item.desc}}</text>
      </view>
    </view>

    <!-- 新增：无匹配结果时展示空状态提示 -->
    <view class="empty-result" wx:if="{{filteredFeedList.length === 0}}">
      <text class="empty-icon">🐾</text>
      <text class="empty-text">没有找到相关萌宠动态</text>
    </view>
  </view>
</view>