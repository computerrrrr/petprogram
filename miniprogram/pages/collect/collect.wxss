/* 我的收藏页面样式 */
.collect-container {
  padding: 30rpx;
  background-color: #FFF8F0;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 页面标题区 */
.page-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 12rpx;
}

.page-desc {
  font-size: 24rpx;
  color: #999999;
}

/* 宠物动态列表样式 (与首页统一) */
.feed-list {
  margin-top: 10rpx;
}

.feed-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 140, 71, 0.1);
}

.feed-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.feed-tag {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background-color: #FFF1E6;
  color: #FF8C47;
  margin-right: 16rpx;
  font-weight: 500;
}

.feed-nickname {
  font-size: 26rpx;
  color: #666666;
  font-weight: 500;
}

.feed-image-box {
  width: 100%;
  height: 360rpx;
  background-color: #F8F8F8;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.feed-image-placeholder {
  font-size: 28rpx;
  color: #CCCCCC;
}

.feed-desc-box {
  margin-top: 10rpx;
}

.feed-desc {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

/* 空状态占位样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

