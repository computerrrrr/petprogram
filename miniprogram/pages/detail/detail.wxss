/* 动态详情页样式 */
.detail-container {
  padding: 30rpx;
  background-color: #FFF8F0;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 顶部信息区 */
.detail-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.detail-tag {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  background-color: #FFF1E6;
  color: #FF8C47;
  margin-right: 20rpx;
  font-weight: 500;
}

.detail-nickname {
  font-size: 30rpx;
  color: #333333;
  font-weight: bold;
}

/* 详情大图占位 */
.detail-image-box {
  width: 100%;
  height: 500rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 140, 71, 0.1);
}

.detail-image-placeholder {
  font-size: 32rpx;
  color: #CCCCCC;
}

/* 正文内容区 */
.detail-content-box {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 140, 71, 0.1);
}

.detail-content {
  font-size: 32rpx;
  color: #333333;
  line-height: 1.8;
  text-align: justify;
}
