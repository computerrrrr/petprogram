/* 我的页面样式 */
.mine-container {
  padding: 30rpx;
  background-color: #FFF8F0;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 1. 用户信息区 (优化为左右布局) */
.user-info-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 140, 71, 0.1);
}

.user-info-left {
  display: flex;
  align-items: center;
}

/* 新增：头像图片样式 */
.avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #FFF1E6;
  margin-right: 24rpx;
  border: 4rpx solid #FFF1E6;
}

.user-info-text {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.user-id {
  font-size: 24rpx;
  color: #999999;
}

/* 新增：编辑按钮样式 */
.edit-btn {
  font-size: 24rpx;
  color: #FF8C47;
  border: 1rpx solid #FF8C47;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
}

/* 新增：统计信息卡片样式 */
.stats-card {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx 0;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 140, 71, 0.1);
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.stats-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF8C47; /* 数字使用暖橙色高亮 */
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 24rpx;
  color: #666666;
}

.stats-divider {
  width: 2rpx;
  height: 60rpx;
  background-color: #F5F5F5;
}

/* 通用卡片样式 */
.section-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-top: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 140, 71, 0.1);
}

/* 2. 我的作品模块 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.section-more {
  font-size: 24rpx;
  color: #FF8C47;
}

.works-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 0;
}

.empty-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #999999;
}

/* 新增：宠物动态列表样式 (与首页/详情页统一) */
.feed-list {
  margin-top: 10rpx;
}

.feed-card {
  background-color: #FFF8F0; /* 我的页面卡片在白底容器内，给个淡背景区分 */
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 140, 71, 0.08);
}

.feed-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.feed-tag {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background-color: #FFF1E6;
  color: #FF8C47;
  margin-right: 16rpx;
  font-weight: 500;
}

.feed-nickname {
  font-size: 26rpx;
  color: #666666;
  font-weight: 500;
}

.feed-image-box {
  width: 100%;
  height: 360rpx;
  background-color: #F5F5F5;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.feed-image-placeholder {
  font-size: 28rpx;
  color: #CCCCCC;
}

.feed-desc-box {
  margin-top: 10rpx;
}

.feed-desc {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

/* 3. 基础设置项 */
.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.setting-last {
  border-bottom: none;
}

.setting-label {
  font-size: 30rpx;
  color: #333333;
}

.setting-arrow {
  font-size: 28rpx;
  color: #CCCCCC;
}
