    <view class="avatar-box">
      <text class="avatar-emoji">🐾</text>
    </view>
    <text class="nickname">宠物爱好者</text>
    <text class="user-id">ID: 10086</text>
  </view>

  <!-- 2. 我的作品模块占位卡片 -->
