<!-- 我的页面 - 静态UI骨架 -->
<view class="mine-container">

  <!-- 1. 用户信息展示区域 (优化) -->
  <view class="user-info-card">
    <view class="user-info-left">
      <!-- 使用 image 组件展示默认头像 -->
      <image class="avatar-img" src="/images/default_avatar.png" mode="aspectFill"></image>
      <view class="user-info-text">
        <text class="nickname">萌宠爱好者</text>
        <text class="user-id">ID: 88888888</text>
      </view>
    </view>
    <view class="edit-btn">编辑</view>
  </view>

  <!-- 新增：统计信息静态UI -->
  <view class="stats-card">
    <view class="stats-item">
      <text class="stats-num">12</text>
      <text class="stats-label">发布数量</text>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item">
      <text class="stats-num">36</text>
      <text class="stats-label">收藏数量</text>
    </view>
  </view>

  <!-- 2. 我的作品模块占位卡片 -->
  <view class="section-card">
    <view class="section-header">
      <text class="section-title">我的作品</text>
      <text class="section-more">查看全部 ></text>
    </view>
    
    <!-- 新增：有数据时渲染列表骨架 -->
    <view class="feed-list" wx:if="{{myWorksList.length > 0}}">
      <view class="feed-card" wx:for="{{myWorksList}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
        <!-- 顶部：分类标签 + 用户昵称 -->
        <view class="feed-header">
          <view class="feed-tag">{{item.category}}</view>
          <text class="feed-nickname">{{item.nickname}}</text>
        </view>
        
        <!-- 宠物配图占位区域 -->
        <view class="feed-image-box" catchtap="onPreviewImage" data-urls="{{item.imageUrls}}">
          <text class="feed-image-placeholder">🖼️ 点击预览图片</text>
        </view>
        
        <!-- 底部：文字简介 -->
        <view class="feed-desc-box">
          <text class="feed-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <!-- 无数据时展示空状态占位 -->
    <view class="works-empty" wx:else>
      <text class="empty-icon">📝</text>
      <text class="empty-text">暂无发布记录</text>
    </view>
  </view>

  <!-- 3. 基础设置占位项 -->
  <view class="section-card">
    <view class="setting-item">
      <text class="setting-label">关于我们</text>
      <text class="setting-arrow">></text>
    </view>
    <view class="setting-item">
      <text class="setting-label">隐私政策</text>
      <text class="setting-arrow">></text>
    </view>
    <view class="setting-item setting-last">
      <text class="setting-label">清除缓存</text>
      <text class="setting-arrow">></text>
    </view>
  </view>

</view>
